rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if client has an active Firebase auth session
    function isSignedIn() {
      return request.auth != null;
    }

    // Fetch user profile from Firestore if it exists
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    // Check if the current user has the 'monitor' (Lớp trưởng) role
    function isMonitor() {
      return getUserData() != null && getUserData().role == 'monitor';
    }

    // =========================================================================
    // 1. USERS & USER PROFILES
    // =========================================================================
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // 2. SCHOOL & MULTI-YEAR ACADEMIC HIERARCHY
    // =========================================================================
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isSignedIn() && !isMonitor();
    }

    match /academicYears/{yearId} {
      allow read: if true;
      allow write: if isSignedIn() && !isMonitor();
    }

    match /semesters/{semesterId} {
      allow read: if true;
      allow write: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 3. CLASSES
    // =========================================================================
    match /classes/{classId} {
      allow read: if true;
      allow write: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 4. STUDENTS & ENROLLMENTS
    // =========================================================================
    match /students/{studentId} {
      allow read: if isSignedIn();
      // Teacher / School can create, update, delete students. Monitor CANNOT!
      allow write: if isSignedIn() && !isMonitor();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 5. BEHAVIOR CATEGORIES & REGULATIONS
    // =========================================================================
    match /behaviorCategories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 6. DISCIPLINE LOGS (Core logging: Both Teacher and Monitor record instantly!)
    // =========================================================================
    match /disciplineLogs/{logId} {
      allow read: if isSignedIn();
      // Teacher, Admin, Monitor can create discipline logs immediately
      allow create: if isSignedIn();
      // Teacher can update any. Monitor can only update if authorized
      allow update: if isSignedIn();
      // Teacher can delete. Monitor CANNOT delete discipline logs!
      allow delete: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 7. SNAPSHOTS & SUMMARIES
    // =========================================================================
    match /weeklySnapshots/{snapshotId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isMonitor();
    }

    match /monthlySummaries/{summaryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isMonitor();
    }

    match /semesterSummaries/{summaryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 8. CLASS CONFIGS (HOMEROOM SETTINGS)
    // =========================================================================
    match /classConfigs/{configId} {
      allow read: if true;
      allow write: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 9. PERIOD LOCKS
    // =========================================================================
    match /periodLocks/{lockId} {
      allow read: if true;
      allow write: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 10. AUDIT LOGS
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // =========================================================================
    // 11. SYSTEM CONFIGURATIONS
    // =========================================================================
    match /systemConfigs/{configId} {
      allow read: if true;
      allow write: if isSignedIn() && !isMonitor();
    }

    // =========================================================================
    // 12. PARENT REPORTS
    // =========================================================================
    match /parentReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isMonitor();
    }
  }
}
