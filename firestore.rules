rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        request.auth != null && (
          request.auth.token.email == 'admin@cdnghe01bqp.edu.vn' ||
          request.auth.token.email == 'sanginnova8@gmail.com' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // 1. Users collection: Allow read and write so teachers can create & manage class accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Classes collection: Allow read and write for class listings & homeroom management
    match /classes/{classId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Students collection: Allow managing students
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Behavior Categories collection: Criteria catalog
    match /behaviorCategories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Discipline Logs collection: Scoring records & behavior violations
    match /disciplineLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Class Configs collection: Homeroom configuration & rules
    match /classConfigs/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Period Locks collection: Weekly/monthly lock status
    match /periodLocks/{lockId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
